# Used for local runs (copy to .env). On Vercel, set these in Project Settings > Environment Variables instead.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
SESSION_SECRET=any-long-random-string
# Only these emails can create an account (comma separated)
ALLOWED_EMAILS=you@example.com,friend@example.com
# Optional AI fallback (shared by everyone who can log in)
LLM_PROVIDERS=gemini
GEMINI_API_KEY=
# OPEN_BROWSER=false
